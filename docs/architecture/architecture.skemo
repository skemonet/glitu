diagram(dir="right" lang="fr")

  card#projet.projet(icon="folder-open") Une présentation
    li slides.md : texte, schémas, code
    li terminaux, images
    to(glitu)

  card#glitu.tool(icon="terminal") glitu
    li build · serve
    li compilateur glitu-core
    li schémas skemo
    to(offline online site)

  zone#sorties.sortie Ce qu'on obtient
    card#offline.sortie(icon="file-down") Hors ligne
      li un fichier, tout dedans
    card#online.sortie(icon="globe") En ligne
      li un HTML court
      to(static).dashed charge
    card#site.sortie(icon="refresh-cw") Site local
      li glitu serve, à la Hugo

  card#static.static(icon="cloud") static.glitu.net
    li moteur, thèmes
    li une version par dossier

  card#mainteneur.mainteneur(icon="user-cog") Mainteneur
    li glitu-site static
    to(static).dashed publie
